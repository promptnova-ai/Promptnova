+// ── COLECCIÓN DINÁMICA ──
+// Convierte los prompts reales que scripts/generate-post.js extrae de cada
+// post (guardados en posts/index.json) en tarjetas de la colección, para que
+// esta sección deje de depender solo de los 12 prompts fijos de arriba y
+// crezca sola con cada post nuevo.
+function buildDynamicPrompts(posts) {
+  const items = [];
+  posts.forEach(post => {
+    const prompts = Array.isArray(post.prompts) ? post.prompts : [];
+    prompts.slice(0, 2).forEach((text, i) => { // máx. 2 por post para no saturar la grilla
+      if (!text || text.trim().length < 20) return; // descarta fragmentos demasiado cortos
+      items.push({
+        id: `blog-${post.slug}-${i}`,
+        cat: post.category || 'general',
+        title: post.title,
+        desc: post.description,
+        text: text.trim(),
+        tools: ['ChatGPT', 'Claude'],
+      });
+    });
+  });
+  return items;
+}
+
+function loadDynamicPrompts() {
+  fetch('./posts/index.json')
+    .then(r => r.json())
+    .then(posts => {
+      if (!Array.isArray(posts)) return;
+      DYNAMIC_PROMPTS = buildDynamicPrompts(posts);
+      // Reaplica el filtro/búsqueda activos para que la grilla ya visible se
+      // actualice con los prompts recién cargados, sin perder dónde estaba el usuario.
+      const searchVal = document.getElementById('prompt-search-input')?.value;
+      if (currentFilter === 'favoritos') {
+        filteredPrompts = getAllPrompts().filter(p => getFavs().includes(p.id));
+      } else if (currentFilter === 'todos') {
+        filteredPrompts = [...getAllPrompts()];
+      } else {
+        filteredPrompts = getAllPrompts().filter(p => p.cat === currentFilter);
+      }
+      if (searchVal) filteredPrompts = filteredPrompts.filter(p => matchSearch(p, searchVal));
+      renderPrompts();
+    })
+    .catch(() => { /* si falla la red, la colección sigue funcionando con los 12 prompts base */ });
+}
+
 // ── BLOG_POSTS embebido (evita depender de un fetch() de red para el contenido inicial) ──
 // Se regenera automáticamente en cada post nuevo por scripts/generate-post.js.
 // BLOG_POSTS_START
@@ -1096,6 +1156,7 @@ document.addEventListener('DOMContentLoaded', () => {
   updateCategoryCounts();
   renderPrompts();
   renderBlog();
+  loadDynamicPrompts();
 });
 </script>
 
